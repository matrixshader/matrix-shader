{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "Website",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:css|js|woff2|webp|png|svg|jpg|mp4|webm))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/303h4rdl1n3/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' fonts.googleapis.com; font-src fonts.gstatic.com; connect-src 'self' api.github.com; img-src 'self' data:"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/install.ps1",
      "destination": "https://raw.githubusercontent.com/matrixshader/matrix-shader/master/installer/install.ps1"
    },
    {
      "source": "/uninstall.ps1",
      "destination": "https://raw.githubusercontent.com/matrixshader/matrix-shader/master/installer/uninstall.ps1"
    },
    {
      "source": "/linux",
      "destination": "https://raw.githubusercontent.com/matrixshader/matrix-shader/master/linux/i.sh"
    }
  ],
  "crons": [
    {
      "path": "/api/backup?auto=1",
      "schedule": "0 6 * * *"
    }
  ]
}
