<Configuration>
  <VGpu>Enable</VGpu>
  <Networking>Enable</Networking>
  <MemoryInMB>4096</MemoryInMB>

  <!-- NOTE: Update HostFolder paths to match YOUR repo location -->
  <!-- Or use launch-sandbox.ps1 which resolves paths automatically -->
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\CHANGE_ME\installer\publish</HostFolder>
      <SandboxFolder>C:\MatrixShader</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\CHANGE_ME\installer\test</HostFolder>
      <SandboxFolder>C:\Test</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>

  <LogonCommand>
    <Command>powershell.exe -ExecutionPolicy Bypass -File C:\Test\validate.ps1</Command>
  </LogonCommand>
</Configuration>
