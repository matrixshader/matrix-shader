    "shaders/Matrix-*.hlsl",
    "shaders/Redpill-Neo.hlsl",
    "install.ps1",
    "bluepill.ps1",
    "matrix_setup.ps1",
    "matrix_control.ps1",
    "matrix_hotkeys.ps1",
    "matrix_monitor.ps1",
    "MatrixUtils.ps1",
    "MatrixLogging.ps1",
    "WindowLayoutEngine.ps1",
    "WindowIdentityService.ps1",
    "README.md",
    "LICENSE"
