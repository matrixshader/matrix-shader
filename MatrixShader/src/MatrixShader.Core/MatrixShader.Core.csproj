<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>MatrixShader.Core</RootNamespace>
    <AssemblyName>MatrixShader.Core</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Disable reflection-based JSON serialization for AOT safety -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Enable AOT compatibility analyzer -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <!-- UI Automation for Layer 4 identity resolution (Windows Desktop only) -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <!-- License secret: embedded at build time from gitignored file -->
  <PropertyGroup>
    <LicenseSecretFile>$(MSBuildThisFileDirectory)..\..\license-secret.key</LicenseSecretFile>
  </PropertyGroup>

  <!-- Read the secret if the file exists, otherwise use dev placeholder -->
  <Target Name="EmbedLicenseSecret" BeforeTargets="CoreCompile">
    <ReadLinesFromFile File="$(LicenseSecretFile)" Condition="Exists('$(LicenseSecretFile)')">
      <Output TaskParameter="Lines" PropertyName="LicenseSecretValue" />
    </ReadLinesFromFile>
    <PropertyGroup Condition="!Exists('$(LicenseSecretFile)')">
      <LicenseSecretValue>DEV-PLACEHOLDER-NOT-FOR-PRODUCTION</LicenseSecretValue>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(IntermediateOutputPath)LicenseSecret.g.cs"
      Lines="namespace MatrixShader.Core.Services%3B%0Ainternal static partial class LicenseSecret%0A{%0A    internal const string Value = &quot;$(LicenseSecretValue)&quot;%3B%0A}"
      Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)LicenseSecret.g.cs" />
    </ItemGroup>
  </Target>

</Project>
